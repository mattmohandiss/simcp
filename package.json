{
  "name": "simulation-mcp-server",
  "version": "0.1.0",
  "description": "Local MCP server for STEP meshing and explicitly configured steady thermal analysis with Gmsh and Elmer.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "simulation-mcp-server": "dist/src/index.js"
  },
  "files": [
    "dist/src",
    "dist/contracts",
    "dist/worker/*.py",
    "!dist/**/*.map",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node scripts/clean-dist.mjs && tsc && node scripts/copy-assets.mjs",
    "prepack": "npm run build",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit.test.ts tests/artifacts.test.ts tests/process.test.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "lint": "oxlint src tests",
    "fmt": "prettier --write src tests scripts package.json tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "vitest": "5.0.3",
    "oxlint": "1.87.0",
    "prettier": "3.9.9",
    "typescript-language-server": "6.0.1"
  }
}
